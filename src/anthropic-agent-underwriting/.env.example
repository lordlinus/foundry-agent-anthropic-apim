APIM_ANTHROPIC_BASE_URL="https://<apim-name>.azure-api.net/anthropic"
APIM_SUBSCRIPTION_KEY="..."

# Initial processing model (fast/medium)
ANTHROPIC_FAST_MODEL_NAME="claude-haiku-4.5"

# Executive judge & summarizer model (large/reasoning)
ANTHROPIC_OPUS_MODEL_NAME="claude-opus-4.7"

# (Optional) Azure AI Foundry Toolbox MCP Endpoint
FOUNDRY_TOOLBOX_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<toolbox-name>/mcp?api-version=v1"
